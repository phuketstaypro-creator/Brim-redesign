# Default repository-managed content. Set to `json` for a CMS export.
CONTENT_ADAPTER=local

# Required only when CONTENT_ADAPTER=json. The file must stay inside the project.
CMS_CONTENT_FILE=content/export.json

# Canonical public origin without a trailing slash.
SITE_URL=https://brim-redesign.vercel.app

# Keep previews and handoff builds out of search results until the final domain is approved.
ALLOW_INDEXING=false
